#: src/quiet-recipes.md:36
msgid ""
"```just\n"
"set quiet\n"
"\n"
"foo:\n"
"  echo \"This is quiet\"\n"
"\n"
"[no-quiet]\n"
"foo2:\n"
"  echo \"This is not quiet\"\n"
"```"
msgstr ""

#: src/quiet-recipes.md:47
msgid "Shebang recipes are quiet by default:"
