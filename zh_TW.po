msgstr ""

#: src/functions.md:274
msgid ""
"`shoutykebabcase(s)`<sup>1.7.0</sup> - Convert `s` to `SHOUTY-KEBAB-CASE`."
msgstr ""

#: src/functions.md:275
msgid ""
"`shoutysnakecase(s)`<sup>1.7.0</sup> - Convert `s` to `SHOUTY_SNAKE_CASE`."
msgstr ""

#: src/functions.md:276
msgid "`snakecase(s)`<sup>1.7.0</sup> - Convert `s` to `snake_case`."
