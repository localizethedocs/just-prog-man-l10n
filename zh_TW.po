#: src/functions.md:236
msgid "String Manipulation"
msgstr ""

#: src/functions.md:238
msgid ""
"`append(suffix, s)`<sup>1.27.0</sup> - Append `suffix` to whitespace-"
"separated strings in `s`. `append('/src', 'foo bar baz')` → `'foo/src bar/"
"src baz/src'`"
msgstr ""

#: src/functions.md:241
msgid ""
"`prepend(prefix, s)`<sup>1.27.0</sup> - Prepend `prefix` to whitespace-"
"separated strings in `s`. `prepend('src/', 'foo bar baz')` → `'src/foo src/"
"bar src/baz'`"
msgstr ""

#: src/functions.md:244
msgid ""
"`encode_uri_component(s)`<sup>1.27.0</sup> - Percent-encode characters in "
"`s` except `[A-Za-z0-9_.!~*'()-]`, matching the behavior of the [JavaScript "
"`encodeURIComponent` function](https://developer.mozilla.org/en-US/docs/Web/"
"JavaScript/Reference/Global_Objects/encodeURIComponent)."
msgstr ""

#: src/functions.md:247
msgid ""
"`quote(s)` - Replace all single quotes with `'\\''` and prepend and append "
"single quotes to `s`. This is sufficient to escape special characters for "
"many shells, including most Bourne shell descendants."
msgstr ""

#: src/functions.md:250
msgid ""
"`replace(s, from, to)` - Replace all occurrences of `from` in `s` with `to`."
msgstr ""

#: src/functions.md:251
msgid ""
"`replace_regex(s, regex, replacement)` - Replace all occurrences of `regex` "
"in `s` with `replacement`. Regular expressions are provided by the [Rust "
"`regex` crate](https://docs.rs/regex/latest/regex/). See the [syntax "
"documentation](https://docs.rs/regex/latest/regex/#syntax) for usage "
"examples. Capture groups are supported. The `replacement` string uses "
"[Replacement string syntax](https://docs.rs/regex/latest/regex/"
"struct.Regex.html#replacement-string-syntax)."
msgstr ""

#: src/functions.md:257
msgid "`trim(s)` - Remove leading and trailing whitespace from `s`."
msgstr ""

#: src/functions.md:258
msgid "`trim_end(s)` - Remove trailing whitespace from `s`."
msgstr ""

#: src/functions.md:259
msgid ""
"`trim_end_match(s, substring)` - Remove suffix of `s` matching `substring`."
msgstr ""

#: src/functions.md:260
msgid ""
"`trim_end_matches(s, substring)` - Repeatedly remove suffixes of `s` "
"matching `substring`."
msgstr ""

#: src/functions.md:262
msgid "`trim_start(s)` - Remove leading whitespace from `s`."
msgstr ""

#: src/functions.md:263
msgid ""
"`trim_start_match(s, substring)` - Remove prefix of `s` matching `substring`."
msgstr ""

#: src/functions.md:264
msgid ""
"`trim_start_matches(s, substring)` - Repeatedly remove prefixes of `s` "
"matching `substring`."
msgstr ""

#: src/functions.md:267
