#: src/user-defined-functions.md:1
msgid "User-defined functions"
msgstr ""

#: src/user-defined-functions.md:3
msgid "New functions may be defined<sup>1.49.0</sup>:"
msgstr ""

#: src/user-defined-functions.md:5
msgid ""
"```just\n"
"set unstable\n"
"\n"
"hello(name) := f\"Hello, {{ name }}!\"\n"
"\n"
"foo:\n"
"  echo '{{ hello(\"World\") }}'\n"
"```"
