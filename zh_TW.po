#: src/user-defined-functions.md:16
msgid "Functions may reference assignments in the same module:"
msgstr ""

#: src/user-defined-functions.md:18
msgid ""
"```just\n"
"set unstable\n"
"\n"
"base := \"foo\"\n"
"\n"
"join(extension) := base + \".\" + extension\n"
"\n"
"create:\n"
"  touch {{ join(\"c\") }}\n"
"  touch {{ join(\"html\") }}\n"
"  touch {{ join(\"txt\") }}\n"
"```"
