#: src/settings.md:1
msgid "Settings"
msgstr ""

#: src/settings.md:3
msgid ""
"Settings control interpretation and execution. Each setting may be specified "
"at most once, anywhere in the `justfile`."
msgstr ""

#: src/settings.md:6
msgid "For example:"
msgstr ""

#: src/settings.md:8
msgid ""
"```just\n"
"set shell := [\"zsh\", \"-cu\"]\n"
"\n"
"foo:\n"
"  # this line will be run as `zsh -cu 'ls **/*.txt'`\n"
"  ls **/*.txt\n"
"```"
msgstr ""

