#: src/metadata.md:1
msgid "Metadata"
msgstr ""

#: src/metadata.md:3
msgid ""
"Metadata in the form of lists of strings may be attached to recipes with the "
"`[metadata(METADATA)]` attribute<sup>1.42.0</sup>:"
msgstr ""

#: src/metadata.md:6
msgid ""
"```just\n"
"[metadata(\"hello\", \"goodbye\")]\n"
"foo:\n"
"```"
msgstr ""

#: src/metadata.md:11
msgid "Metadata can be read using `just --dump --dump-format json`."
msgstr ""
